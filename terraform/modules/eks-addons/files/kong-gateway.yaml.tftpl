image:
  repository: kong
  tag: "3.7"

env:
  database: "off"
  # Makes Kong build redirects as https://host/ (443), not https://host:8443/
  port_maps: "80:8000,443:8443"

proxy:
  enabled: true
  type: LoadBalancer

  http:
    enabled: true
    servicePort: 80
    containerPort: 8000

  tls:
    enabled: true
    servicePort: 443
    containerPort: 8443

  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: "external"
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "instance"
    service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled: "true"

    # ACM termination on 443 only; 80 stays plain TCP
    service.beta.kubernetes.io/aws-load-balancer-ssl-cert: "${acm_certificate_arn}"
    service.beta.kubernetes.io/aws-load-balancer-ssl-ports: "443"
    service.beta.kubernetes.io/aws-load-balancer-ssl-negotiation-policy: "ELBSecurityPolicy-TLS13-1-2-2021-06"

    # Re-encrypt to Kong's TLS listener
    service.beta.kubernetes.io/aws-load-balancer-backend-protocol: "ssl"

    external-dns.alpha.kubernetes.io/hostname: "${domain},[www.${domain},api.${domain}](https://www.${domain},api.${domain})"
# ---------------------------------------------------------------------------
# Admin API — internal only (ClusterIP)
# ---------------------------------------------------------------------------
admin:
  enabled: true
  type: ClusterIP
  http:
    enabled: true
    servicePort: 8001
    containerPort: 8001
  tls:
    enabled: false
  ingress:
    enabled: false

# ---------------------------------------------------------------------------
# Manager (Kong Manager UI) — internal only
# ---------------------------------------------------------------------------
manager:
  enabled: true
  type: ClusterIP
  http:
    enabled: true
    servicePort: 8002
    containerPort: 8002
  tls:
    enabled: false
  ingress:
    enabled: false

# ---------------------------------------------------------------------------
# Enterprise features (disabled for OSS)
# ---------------------------------------------------------------------------
enterprise:
  enabled: false

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi

# ---------------------------------------------------------------------------
# Autoscaling
# ---------------------------------------------------------------------------
autoscaling:
  enabled: false
  minReplicas: 2
  maxReplicas: 10
  targetCPUUtilizationPercentage: 70

# ---------------------------------------------------------------------------
# Replicas
# ---------------------------------------------------------------------------
replicaCount: 2

# ---------------------------------------------------------------------------
# Pod security
# ---------------------------------------------------------------------------
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000

containerSecurityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL