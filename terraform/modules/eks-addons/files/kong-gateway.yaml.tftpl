# =============================================================================
# Kong Gateway — Helm values
#
# Kong is the in-cluster API Gateway. It is exposed via a Service of type
# LoadBalancer. The AWS Load Balancer Controller provisions an NLB in the
# public subnets to forward traffic to Kong's proxy port.
#
# TLS:
#   - NLB listener on port 443 terminates TLS using the ACM certificate.
#     (Configured via the service.beta.kubernetes.io/aws-load-balancer-*
#     annotations below.)
#   - Kong's proxy listens on port 8443 (TLS) and 8000 (HTTP).
#   - Backend services behind Kong use HTTP inside the cluster.
# =============================================================================

# ---------------------------------------------------------------------------
# Kong image & proxy
# ---------------------------------------------------------------------------
image:
  repository: kong
  tag: "3.7"


proxy:
  enabled: true
  type: LoadBalancer

  # NLB listens on 80 and 443
  http:
    enabled: true
    servicePort: 80
    containerPort: 8000
  tls:
    enabled: false

  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: "external"
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "instance"
    service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled: "true"
    
    # 1. Open ports 80 (HTTP) and 443 (HTTPS) on the NLB
    service.beta.kubernetes.io/aws-load-balancer-ports: "80, 443"
    
    # 2. Map port 80 and port 443 traffic to Kong's internal port 8000
    service.beta.kubernetes.io/aws-load-balancer-target-group-attributes: "proxy_protocol.v2.enabled=false"
    
    # 3. Attach your ACM Certificate ARN
    service.beta.kubernetes.io/aws-load-balancer-ssl-cert: "arn:aws:acm:us-east-2:557797815982:certificate/0dd842e4-e23b-4a6e-81f9-10d9e7c62dce"
    
    # 4. Only terminate SSL on port 443
    service.beta.kubernetes.io/aws-load-balancer-ssl-ports: "443"
    
    # 5. FORCE HTTP TO HTTPS REDIRECT ON THE NLB
    service.beta.kubernetes.io/aws-load-balancer-ssl-redirect: "443"
    
    service.beta.kubernetes.io/aws-load-balancer-backend-protocol: "tcp"
    service.beta.kubernetes.io/aws-load-balancer-ssl-negotiation-policy: "ELBSecurityPolicy-TLS13-1-2-2021-06"
    external-dns.alpha.kubernetes.io/hostname: "ahmedmahfouz.click,www.ahmedmahfouz.click,api.ahmedmahfouz.click"

  # -- TLS secret for Kong's own proxy (optional — NLB already terminates TLS)
  #    If you want re-encryption to the pod, mount a cert-manager issued cert here.

# ---------------------------------------------------------------------------
# Database mode — "postgres" or "dbless"
# "dbless" is simpler: declarative config via DB-less mode.
# For production with dynamic route management, use "postgres".
# ---------------------------------------------------------------------------
env:
  database: "off"
  # # PostgreSQL connection string — point to in-cluster PostgreSQL
  # # Override at deploy time for your specific PG instance
  # pg_host: "postgresql-primary.default.svc.cluster.local"
  # pg_port: "5432"
  # pg_database: "kong"
  # pg_user: "kong"
  # # pg_password should come from a Secret; set via --set at deploy time.
  # # Set via env.secrets or separate secret. For now, set via --set.
  # pg_password: "CHANGE_ME"

# ---------------------------------------------------------------------------
# Admin API — internal only (ClusterIP)
# ---------------------------------------------------------------------------
admin:
  enabled: true
  type: ClusterIP
  http:
    enabled: true
    servicePort: 8001
    containerPort: 8001
  tls:
    enabled: false

  # Disable admin ingress
  ingress:
    enabled: false

# ---------------------------------------------------------------------------
# Manager (Kong Manager UI) — internal only
# ---------------------------------------------------------------------------
manager:
  enabled: true
  type: ClusterIP
  http:
    enabled: true
    servicePort: 8002
    containerPort: 8002
  tls:
    enabled: false
  ingress:
    enabled: false

# ---------------------------------------------------------------------------
# Enterprise features (disabled for OSS)
# ---------------------------------------------------------------------------
enterprise:
  enabled: false

# ---------------------------------------------------------------------------
# Plugins bundled with Kong OSS
# ---------------------------------------------------------------------------
# Kong OSS includes: cors, rate-limiting, key-auth, jwt, oauth2, etc.

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi

# ---------------------------------------------------------------------------
# Autoscaling
# ---------------------------------------------------------------------------
autoscaling:
  enabled: false
  minReplicas: 2
  maxReplicas: 10
  targetCPUUtilizationPercentage: 70

# ---------------------------------------------------------------------------
# Replicas
# ---------------------------------------------------------------------------
replicaCount: 2

# ---------------------------------------------------------------------------
# Pod security
# ---------------------------------------------------------------------------
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000

containerSecurityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
