apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: api-routes
  namespace: ${namespace}
  annotations:
    konghq.com/strip-path: "false"
    konghq.com/protocols: "https"
    konghq.com/https-redirect-status-code: "301"
    konghq.com/plugins: cors-plugin,rate-limiting-plugin
spec:
  ingressClassName: kong
  rules:
    - host: api.${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: backend-prod
                port:
                  number: 8000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: frontend-routes
  namespace: ${namespace}
  annotations:
    konghq.com/strip-path: "false"
    konghq.com/protocols: "https"
    konghq.com/https-redirect-status-code: "301"
spec:
  ingressClassName: kong
  rules:
    - host: ${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend-prod
                port:
                  number: 8080
    - host: www.${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend-prod
                port:
                  number: 8080

---
# =============================================================================
# KongPlugin: CORS for the API
# =============================================================================
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: cors-plugin
  namespace: ${namespace}
plugin: cors
config:
  origins:
    - "https://${route53_zone_name}"
    - "https://www.${route53_zone_name}"
  methods:
    - GET
    - POST
    - PUT
    - PATCH
    - DELETE
    - OPTIONS
  headers:
    - Accept
    - Accept-Version
    - Content-Length
    - Content-MD5
    - Content-Type
    - Date
    - Authorization
  exposed_headers:
    - X-Auth-Token
  credentials: true
  max_age: 3600
  preflight_continue: false

---
# =============================================================================
# KongPlugin: Rate Limiting for the API
# =============================================================================
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: rate-limiting-plugin
  namespace: ${namespace}
plugin: rate-limiting
config:
  minute: 100
  hour: 1000
  policy: local