# =============================================================================
# Kong routes for the prod namespace
#
# Rules:
#   - An Ingress can only reference Services in its OWN namespace, so this file
#     only contains routes for Services that live in ${namespace}
#     (backend-prod, frontend-prod).
#   - Grafana (monitoring) and SonarQube (sonarqube) are NOT routed from here.
#     Their ingresses belong in their own namespaces (set via each Helm chart's
#     ingress values), otherwise Kong gets duplicate hosts with empty upstreams
#     and returns "failure to get a peer from the ring-balancer".
# =============================================================================

# -----------------------------------------------------------------------------
# Plugins (must live in the same namespace as the Ingress that uses them)
# -----------------------------------------------------------------------------
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: cors-plugin
  namespace: ${namespace}
plugin: cors
config:
  origins:
    - "https://${route53_zone_name}"
    - "https://www.${route53_zone_name}"
  methods: [GET, POST, PUT, PATCH, DELETE, OPTIONS]
  headers:
    - Accept
    - Accept-Version
    - Content-Length
    - Content-MD5
    - Content-Type
    - Date
    - Authorization
  exposed_headers:
    - X-Auth-Token
  credentials: true
  max_age: 3600
  preflight_continue: false
---
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: rate-limiting-plugin
  namespace: ${namespace}
plugin: rate-limiting
config:
  minute: 100
  hour: 1000
  limit_by: ip
  policy: local
---
# Looser limit for the frontend: a page load fires many asset requests,
# so the API limit above would cause 429s for normal users.
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: frontend-rate-limiting-plugin
  namespace: ${namespace}
plugin: rate-limiting
config:
  minute: 600
  hour: 6000
  limit_by: ip
  policy: local
---
# -----------------------------------------------------------------------------
# Ingress: API  (api.<zone> -> backend-prod:8000)
# -----------------------------------------------------------------------------
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: api-routes
  namespace: ${namespace}
  annotations:
    konghq.com/strip-path: "false"
    konghq.com/protocols: "https"
    konghq.com/https-redirect-status-code: "301"
    konghq.com/service-upstream: "true"
    konghq.com/plugins: cors-plugin,rate-limiting-plugin
spec:
  ingressClassName: kong
  rules:
    - host: api.${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: backend-prod
                port:
                  number: 8000
---
# -----------------------------------------------------------------------------
# Ingress: Frontend  (<zone>, www.<zone> -> frontend-prod:8080)
# No CORS here: the browser loads the frontend as a same-origin page.
# -----------------------------------------------------------------------------
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: frontend-routes
  namespace: ${namespace}
  annotations:
    konghq.com/strip-path: "false"
    konghq.com/protocols: "https"
    konghq.com/https-redirect-status-code: "301"
    konghq.com/service-upstream: "true"
    konghq.com/plugins: frontend-rate-limiting-plugin
spec:
  ingressClassName: kong
  rules:
    - host: ${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend-prod
                port:
                  number: 8080
    - host: www.${route53_zone_name}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend-prod
                port:
                  number: 8080