# ecommerce-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: ecommerce-secret
  namespace: ${namespace}
type: Opaque
stringData:
  DATABASE_URL: "${database_url}"
  SECRET_KEY: "${secret_key}"
  postgres-password: "${postgres_password}"
  MONGODB_URL: "mongodb://root:${mongodb_password}@mongodb:27017/ecommerce?authSource=admin"
  mongodb-root-password: "${mongodb_password}"
  mongodb-passwords: "${mongodb_password}"

