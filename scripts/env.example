# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ecommerce

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@db:5432/ecommerce
SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_PORT=8000

# AWS configuration
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=          # optional: local dev only if not using AWS profile / SSO
AWS_SECRET_ACCESS_KEY=      # optional: local dev only if not using AWS profile / SSO

# S3 assets bucket for product images
S3_ASSETS_BUCKET=ecommerce-staging-us-east-2-assets
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

# Public CloudFront CDN domain for product images
CDN_ASSETS_DOMAIN=cdn.ahmedmahfouz.click

# SES sender email (required for registration email verification)
SES_SENDER_EMAIL=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173

# --- Image tags (used by docker-compose.yml) ---
BACKEND_IMAGE=ahmedmahfouz0/backend:latest
FRONTEND_IMAGE=ahmedmahfouz0/frontend:latest
